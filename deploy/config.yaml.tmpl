config-version: 8

server:
  host: ""
  port: 8317

management:
  allow-remote: true
  secret-key: ""

access:
  api-keys:
    - ${LLM_ACCESS_TOKEN}

oauth:
  auth-dir: /root/.cli-proxy-api

routing:
  retry:
    request-retry: 3

observability:
  accounting-outbox:
    enabled: true
    data-path: /data/outbox
    litellm:
      enabled: true
      url: https://llm.blamedevs.com
      admin-key-env: LITELLM_ACCOUNTING_ADMIN_KEY
      clients:
        "a1ddde2e73eba622cb6d85f1f94bbcd12fa73db26699aa210725c2a5b0c8f3ef":
          key-hash: "${LITELLM_KEY_HASH}"
  pricing:
    litellm-catalog-url: https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
