config-version: 8

server:
  host: ""
  port: 8317

management:
  allow-remote: true
  secret-key: ""

access:
  api-keys:
    - ${LLM_ACCESS_TOKEN}

oauth:
  auth-dir: /root/.cli-proxy-api

routing:
  strategy: nearest-reset
  session-affinity: true
  retry:
    request-retry: 3

observability:
  loki:
    enabled: true
    url: https://logs-prod-012.grafana.net
    user-id: "1799812"
  accounting-outbox:
    enabled: true
    data-path: /data/outbox
    idv:
      enabled: true
      url: https://analytics.blamedevs.com
      dataset: pawel/llm_usage
      prices-dataset: pawel/llm_prices
    pricing:
      litellm-catalog-url: https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
