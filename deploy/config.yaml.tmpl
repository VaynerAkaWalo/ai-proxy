config-version: 8

server:
  host: ""
  port: 8317

management:
  allow-remote: true
  secret-key: ""

access:
  api-keys:
    - ${LLM_ACCESS_TOKEN}

oauth:
  auth-dir: /root/.cli-proxy-api

routing:
  session-affinity: true
  retry:
    request-retry: 3

observability:
  loki:
    enabled: true
    url: https://logs-prod-012.grafana.net
    user-id: "1799812"
  accounting-outbox:
    enabled: true
    data-path: /data/outbox
    litellm:
      enabled: true
      url: https://llm.blamedevs.com
      admin-key-env: LITELLM_ACCOUNTING_ADMIN_KEY
      clients:
        "${LITELLM_CLIENT_ID}":
          key-hash: "${LITELLM_KEY_HASH}"
    pricing:
      litellm-catalog-url: https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
