{
  "id": "llm-usage",
  "title": "LLM usage",
  "models": [
    "llm_usage"
  ],
  "time": {
    "default": {
      "last": 7,
      "unit": "day"
    },
    "options": [
      {
        "last": 7,
        "unit": "day"
      },
      {
        "last": 30,
        "unit": "day"
      },
      {
        "last": 90,
        "unit": "day"
      },
      {
        "last": 1,
        "unit": "day"
      }
    ]
  },
  "filters": [
    {
      "dimension": "provider",
      "label": "Provider"
    },
    {
      "dimension": "executed_model",
      "label": "Model"
    },
    {
      "dimension": "project",
      "label": "Project"
    }
  ],
  "sections": [
    {
      "title": "Overview",
      "widgets": [
        {
          "id": "spend",
          "title": "Spend",
          "span": 4,
          "height": "xs",
          "type": "stat",
          "query": {
            "model": "llm_usage",
            "measures": [
              "spend_usd"
            ],
            "dimensions": [],
            "where": [],
            "time": {
              "dimension": "time"
            }
          },
          "windows": [
            {
              "window": "all"
            },
            {
              "window": {
                "last": 1,
                "unit": "month"
              }
            },
            {
              "window": "dashboard"
            }
          ]
        },
        {
          "id": "paid",
          "title": "Paid",
          "span": 4,
          "height": "xs",
          "type": "stat",
          "query": {
            "model": "llm_usage",
            "measures": [
              "subscription_costs.paid_usd"
            ],
            "dimensions": [],
            "where": [],
            "time": {
              "dimension": "time"
            }
          },
          "windows": [
            {
              "window": "all"
            },
            {
              "window": {
                "last": 1,
                "unit": "month"
              }
            },
            {
              "window": "dashboard",
              "blank": true
            }
          ]
        },
        {
          "id": "tokens",
          "title": "Tokens",
          "span": 4,
          "height": "xs",
          "type": "stat",
          "query": {
            "model": "llm_usage",
            "measures": [
              "attempts.total_tokens"
            ],
            "dimensions": [],
            "where": [],
            "time": {
              "dimension": "time"
            }
          },
          "windows": [
            {
              "window": "all"
            },
            {
              "window": {
                "last": 1,
                "unit": "month"
              }
            },
            {
              "window": "dashboard"
            }
          ]
        },
        {
          "id": "spend-by-model",
          "title": "Spend by model",
          "span": 4,
          "height": "md",
          "type": "table",
          "layout": "bars",
          "query": {
            "model": "llm_usage",
            "measures": [
              "spend_usd"
            ],
            "dimensions": [
              "executed_model"
            ],
            "where": [],
            "time": {
              "dimension": "time"
            }
          },
          "sort": {
            "by": "spend_usd",
            "dir": "desc"
          },
          "limit": 6
        },
        {
          "id": "spend-by-project",
          "title": "Spend by project",
          "span": 4,
          "height": "md",
          "type": "table",
          "layout": "bars",
          "query": {
            "model": "llm_usage",
            "measures": [
              "spend_usd"
            ],
            "dimensions": [
              "project"
            ],
            "where": [],
            "time": {
              "dimension": "time"
            }
          },
          "sort": {
            "by": "spend_usd",
            "dir": "desc"
          },
          "limit": 6
        },
        {
          "id": "quota-left",
          "title": "Weekly quota left",
          "span": 4,
          "height": "md",
          "type": "table",
          "layout": "bars",
          "max": 1,
          "marker": {
            "window": {
              "last": 7,
              "unit": "day"
            }
          },
          "query": {
            "model": "llm_usage",
            "measures": [
              "quota_snapshots.remaining_utilization",
              "quota_snapshots.latest_resets_at"
            ],
            "dimensions": [
              "provider",
              "account"
            ],
            "where": [
              {
                "dimension": "quota_window",
                "op": "eq",
                "value": "weekly"
              }
            ]
          },
          "period": {
            "name": "quota_reset",
            "window": "current"
          },
          "hide_window": true,
          "sort": {
            "by": "quota_snapshots.remaining_utilization",
            "dir": "asc"
          }
        },
        {
          "id": "models",
          "title": "Models",
          "span": 12,
          "height": "md",
          "type": "table",
          "query": {
            "model": "llm_usage",
            "measures": [
              "spend_usd",
              "spend_per_mtok_usd",
              "attempts.cache_read_share",
              "spend_per_session_usd"
            ],
            "dimensions": [
              "executed_model"
            ],
            "where": [],
            "time": {
              "dimension": "time"
            }
          },
          "sort": {
            "by": "spend_usd",
            "dir": "desc"
          },
          "limit": 8,
          "labels": {
            "executed_model": "Model",
            "spend_usd": "Spend",
            "spend_per_mtok_usd": "$ / Mtok",
            "attempts.cache_read_share": "Cache hit",
            "spend_per_session_usd": "$ / conversation"
          }
        }
      ]
    }
  ]
}
