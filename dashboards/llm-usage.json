{
  "id": "llm-usage",
  "title": "LLM usage",
  "models": [
    "llm_usage"
  ],
  "time": {
    "default": {
      "last": 7,
      "unit": "day"
    },
    "options": [
      {
        "last": 7,
        "unit": "day"
      },
      {
        "last": 30,
        "unit": "day"
      },
      {
        "last": 90,
        "unit": "day"
      },
      {
        "last": 1,
        "unit": "day"
      }
    ]
  },
  "filters": [
    {
      "dimension": "provider",
      "label": "Provider"
    },
    {
      "dimension": "executed_model",
      "label": "Model"
    },
    {
      "dimension": "project",
      "label": "Project"
    }
  ],
  "sections": [
    {
      "title": "Overview",
      "widgets": [
        {
          "id": "spend-all-time",
          "title": "Total spend",
          "span": 4,
          "height": "xs",
          "type": "stat",
          "query": {
            "model": "llm_usage",
            "measures": [
              "spend_usd"
            ],
            "dimensions": [],
            "where": [],
            "time": {
              "dimension": "time"
            }
          },
          "window": "all",
          "secondary": "subscription_costs.paid_usd",
          "labels": {
            "subscription_costs.paid_usd": "paid"
          }
        },
        {
          "id": "spend-this-month",
          "title": "Spend this month",
          "span": 4,
          "height": "xs",
          "type": "stat",
          "query": {
            "model": "llm_usage",
            "measures": [
              "spend_usd"
            ],
            "dimensions": [],
            "where": [],
            "time": {
              "dimension": "time"
            }
          },
          "window": {
            "last": 1,
            "unit": "month"
          },
          "secondary": "subscription_costs.paid_usd",
          "labels": {
            "subscription_costs.paid_usd": "paid"
          }
        },
        {
          "id": "tokens-total",
          "title": "Tokens",
          "span": 4,
          "height": "xs",
          "type": "stat",
          "query": {
            "model": "llm_usage",
            "measures": [
              "attempts.total_tokens"
            ],
            "dimensions": [],
            "where": [],
            "time": {
              "dimension": "time"
            }
          },
          "compare": "previous_period"
        },
        {
          "id": "spend-by-model",
          "title": "Spend by model",
          "span": 4,
          "height": "md",
          "type": "table",
          "layout": "bars",
          "query": {
            "model": "llm_usage",
            "measures": [
              "spend_usd"
            ],
            "dimensions": [
              "executed_model"
            ],
            "where": [],
            "time": {
              "dimension": "time"
            }
          },
          "sort": {
            "by": "spend_usd",
            "dir": "desc"
          },
          "limit": 6
        },
        {
          "id": "spend-by-project",
          "title": "Spend by project",
          "span": 4,
          "height": "md",
          "type": "table",
          "layout": "bars",
          "query": {
            "model": "llm_usage",
            "measures": [
              "spend_usd"
            ],
            "dimensions": [
              "project"
            ],
            "where": [],
            "time": {
              "dimension": "time"
            }
          },
          "sort": {
            "by": "spend_usd",
            "dir": "desc"
          },
          "limit": 6
        },
        {
          "id": "quota-left",
          "title": "Weekly quota left",
          "span": 4,
          "height": "md",
          "type": "table",
          "layout": "bars",
          "max": 1,
          "marker": {
            "window": {
              "last": 7,
              "unit": "day"
            }
          },
          "query": {
            "model": "llm_usage",
            "measures": [
              "quota_snapshots.remaining_utilization",
              "quota_snapshots.latest_resets_at"
            ],
            "dimensions": [
              "provider",
              "account"
            ],
            "where": [
              {
                "dimension": "quota_window",
                "op": "eq",
                "value": "weekly"
              }
            ]
          },
          "period": {
            "name": "quota_reset",
            "window": "current"
          },
          "hide_window": true,
          "sort": {
            "by": "quota_snapshots.remaining_utilization",
            "dir": "asc"
          }
        },
        {
          "id": "models",
          "title": "Models",
          "span": 12,
          "height": "md",
          "type": "table",
          "query": {
            "model": "llm_usage",
            "measures": [
              "spend_usd",
              "spend_per_mtok_usd",
              "attempts.cache_read_share",
              "spend_per_session_usd"
            ],
            "dimensions": [
              "executed_model"
            ],
            "where": [],
            "time": {
              "dimension": "time"
            }
          },
          "sort": {
            "by": "spend_usd",
            "dir": "desc"
          },
          "limit": 8,
          "labels": {
            "executed_model": "Model",
            "spend_usd": "Spend",
            "spend_per_mtok_usd": "$ / Mtok",
            "attempts.cache_read_share": "Cache hit",
            "spend_per_session_usd": "$ / conversation"
          }
        }
      ]
    },
    {
      "title": "Details",
      "widgets": [
        {
          "id": "cost-by-project",
          "title": "Cost by project (USD)",
          "span": 6,
          "height": "md",
          "type": "table",
          "query": {
            "model": "llm_usage",
            "measures": [
              "spend_usd"
            ],
            "dimensions": [
              "project"
            ],
            "where": [],
            "time": {
              "dimension": "time"
            }
          },
          "share": "spend_usd",
          "sort": {
            "by": "spend_usd",
            "dir": "desc"
          },
          "limit": 8,
          "labels": {
            "project": "Project",
            "spend_usd": "Spend"
          }
        },
        {
          "id": "tokens",
          "title": "Tokens (M/day)",
          "span": 6,
          "height": "md",
          "query": {
            "model": "llm_usage",
            "measures": [
              "attempts.cache_read_tokens",
              "attempts.input_uncached_tokens",
              "attempts.output_tokens"
            ],
            "dimensions": [],
            "where": [],
            "time": {
              "dimension": "time",
              "granularity": "day"
            }
          },
          "labels": {
            "attempts.output_tokens": "output",
            "attempts.cache_read_tokens": "cache read",
            "attempts.input_uncached_tokens": "input"
          },
          "type": "bar",
          "stacked": true
        },
        {
          "id": "outcomes",
          "title": "Failed and interrupted (per day)",
          "span": 6,
          "height": "md",
          "query": {
            "model": "llm_usage",
            "measures": [
              "attempts.failed_attempts",
              "attempts.interrupted_attempts",
              "attempts.unpriced_attempts"
            ],
            "dimensions": [],
            "where": [],
            "time": {
              "dimension": "time",
              "granularity": "day"
            }
          },
          "labels": {
            "attempts.failed_attempts": "failed",
            "attempts.unpriced_attempts": "unpriced",
            "attempts.interrupted_attempts": "interrupted"
          },
          "type": "bar",
          "stacked": true
        },
        {
          "id": "latency",
          "title": "Latency (s)",
          "span": 6,
          "height": "md",
          "query": {
            "model": "llm_usage",
            "measures": [
              "attempts.latency_p50_seconds",
              "attempts.latency_p95_seconds"
            ],
            "dimensions": [],
            "where": [],
            "time": {
              "dimension": "time",
              "granularity": "day"
            }
          },
          "labels": {
            "attempts.latency_p50_seconds": "p50",
            "attempts.latency_p95_seconds": "p95"
          },
          "type": "line"
        }
      ]
    }
  ]
}
